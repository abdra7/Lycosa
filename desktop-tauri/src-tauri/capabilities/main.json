{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "The main window: event listening plus Lycosa's own typed commands. No shell, filesystem, HTTP or opener access is granted to the frontend; those stay in Rust behind validated commands (ADR-037).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-session-state",
    "allow-session-restore",
    "allow-session-add-profile",
    "allow-session-login",
    "allow-session-logout",
    "allow-session-switch",
    "allow-session-remove-profile",
    "allow-api-request",
    "allow-api-stream",
    "allow-api-stream-cancel",
    "allow-knowledge-upload",
    "allow-events-start",
    "allow-events-stop",
    "allow-lan-scan",
    "allow-lan-ipv4",
    "allow-oauth-loopback-start",
    "allow-oauth-loopback-wait",
    "allow-oauth-loopback-cancel",
    "allow-open-sign-in-page",
    "allow-standalone-status",
    "allow-standalone-enable",
    "allow-standalone-disable",
    "allow-standalone-start",
    "allow-standalone-stop",
    "allow-standalone-restart",
    "allow-standalone-logs",
    "allow-standalone-set-network",
    "allow-standalone-set-local-node",
    "allow-standalone-sign-in",
    "allow-standalone-open-data-dir",
    "allow-standalone-backup-now"
  ]
}
